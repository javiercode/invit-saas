rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // Invitaciones: lectura pública; crea cualquier usuario autenticado;
    // edita el ADMIN o el dueño (userId, o ownerId en documentos anteriores)
    match /invitaciones/{invitationId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid));
    }

    match /confirmaciones_rsvp/{rsvpId} {
      allow create: if true;
      allow read, update, delete: if signedIn();
    }

    match /servicios/{servicioId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Perfiles: cada usuario administra el suyo; el ADMIN gestiona todos
    match /usuarios/{userId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }
  }
}
